# FARCI — configuration Open WebUI
# Copier en .env et compléter

# Connexion OAI-compatible via Caddy
OAI_API_BASE_URL=http://192.168.50.15/v1
DEFAULT_MODEL=med-extraction

# Authentification
ENABLE_SIGNUP=false
ENABLE_LOGIN_FORM=true

# Clé API virtuelle (créée par post-setup.sh)
OPENAI_API_KEY=sk-standard-placeholder
