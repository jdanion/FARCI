# FARCI — aliases de modèles logiques (FARCI §18)
#
# Ces aliases sont la SEULE chose que les applications voient.
# Les vrais noms de modèles (ornith-1.5-9b, qwen3.8-27b) sont masqués.

# Alias par défaut : Ollama primaire + llama.cpp fallback
MED_EXTRACTION_MODEL=med-extraction
MED_EXTRACTION_PRIMARY=ollama
MED_EXTRACTION_FALLBACK=llamacpp

# Alias "lite" : Qwen3.5-2B (CI, tests rapides)
MED_EXTRACTION_LITE_MODEL=med-extraction-lite

# Alias "max" : Qwen3.8-27B (postes >= 24 Go VRAM)
MED_EXTRACTION_MAX_MODEL=med-extraction-max

# Alias "mac" : oMLX (Mac >= 32 Go RAM)
MED_EXTRACTION_MAC_MODEL=med-extraction-mac

# Clés API
# sk-standard : 10 RPM (étudiants)
# sk-priority : 120 RPM (formateur, demos)
LITELLM_API_KEY_STANDARD=sk-standard-placeholder
LITELLM_API_KEY_PRIORITY=sk-priority-placeholder
