{
  "gateway": {
    "port": 4001,
    "host": "0.0.0.0"
  },
  "models": [
    {
      "alias": "med-extraction",
      "backend": "openai",
      "url": "env.FARCI_RUNTIME_URL",
      "model": "med-extraction"
    },
    {
      "alias": "med-extraction-lite",
      "backend": "openai",
      "url": "env.FARCI_RUNTIME_URL",
      "model": "med-extraction-lite"
    }
  ],
  "fallbacks": {
    "med-extraction": ["med-extraction-lite"]
  },
  "rate_limit": {
    "default": 10,
    "sk-priority-*": 120
  },
  "reasoning": "strip"
}
