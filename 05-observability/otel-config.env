# FARCI — configuration OpenTelemetry
#
# Variables d'environnement pour l'instrumentation OTel.

# Endpoint OTLP : NON écrit ici. scripts/dev-env.sh le dérive de
# config/network.env (Phoenix, http://<OBSERVABILITY_A_IP>:<PHOENIX_PORT>/v1/traces).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Service
OTEL_SERVICE_NAME=farci-app
OTEL_SERVICE_VERSION=1.0.0

# Resource attributes
OTEL_RESOURCE_ATTRIBUTES=service.name=farci-app,service.version=1.0.0,deployment.environment=workshop

# Sampling
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# Exporters
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp

# Headers (si auth requise)
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20token
