#!/usr/bin/env bash
# FARCI — versions figées (FARCI §6)
#
# RÈGLE ABSOLUE : jamais `latest`, jamais `main`, jamais un tag flottant.
# Chaque tag ci-dessous a été vérifié comme EXISTANT par
# `scripts/lock-digests.sh` (phase 1), via `docker manifest inspect`.
#
# Les empreintes SHA256 des images sont dans versions.lock.env, généré en phase
# online. Tant que ce fichier est absent, `make verify-manifest` le signale et
# `make lint-versions` émet un avertissement (pas une erreur).
#
# Fichier versionné : c'est la SELE source de vérité des versions. Aucun
# docker-compose.yml ne doit écrire une version en dur (contrôlé par le lint).

# --- Équipe 0 : GitOps ------------------------------------------------------
GITEA_VERSION=1.27.3
GITEA_ACT_RUNNER_VERSION=0.6.1
POSTGRES_VERSION=18.6-alpine

# --- Équipe 1 : réseau et dashboard ----------------------------------------
CADDY_VERSION=2.11.4-alpine
UPTIME_KUMA_VERSION=2.5.5

# --- Équipe 2 : inference ---------------------------------------------------
# Attention : l'image officielle llama.cpp n'a PAS de tag semver et n'existe pas
# en linux/arm64. Nous construisons donc farci/llamacpp:server-b<N> localement
# pendant le préchargement (voir docs/AIRGAP.md). LLAMACPP_BUILD est le numéro
# de build llama.cpp à compiler depuis les sources.
OLLAMA_VERSION=0.34.4
LLAMACPP_BUILD=b10600

# --- Équipe 3 : passerelle LLM ---------------------------------------------
LITELLM_VERSION=1.102.1
# Bifrost est l'implémentation OPTIONNELLE (FARCI §17 option 3B). v1.6.0 est le
# tag le plus récent publié sur ghcr (vérifié au gel du workshop) ; à revérifier
# si le temps le permet avant le workshop.
BIFROST_VERSION=1.6.0

# --- Équipe 4 : documents ---------------------------------------------------
# L'image docling-serve est publiée sous l'ancien namespace ds4sd. La version
# PyPI (docling-serve 1.35.0) et la version de l'image (v0.5.1) sont deux
# numérotations différentes : voir docs/AIRGAP.md.
DOCLING_SERVE_VERSION=0.5.1

# --- Équipe 5 : observabilité ----------------------------------------------
PHOENIX_VERSION=20.16.0
LANGFUSE_VERSION=4.46.0

# --- Équipe 6 : évaluation --------------------------------------------------
MLFLOW_VERSION=3.16.1

# --- Étape 2 : applications clientes ---------------------------------------
OPEN_WEBUI_VERSION=0.11.4
FLOWISE_VERSION=3.1.4

# --- Images utilitaires -----------------------------------------------------
REDIS_VERSION=8.8.3-alpine
PYTHON_VERSION=3.13.15
PYTHON_IMAGE_TAG=3.13.15-slim-trixie

# --- Modèles (FARCI §9, choix documenté dans PLAN.md §0.2) ------------------
# Ce sont des LOGIQUES, pas des images : le runtime est interchangeable.
FARCI_MODEL_PRIMARY=ornith-1.5-9b
FARCI_MODEL_PRIMARY_QUANT=q5km
FARCI_MODEL_LARGE=qwen3.8-27b
FARCI_MODEL_LARGE_QUANT=q4km
# Modèle de CI et de développement : volontairement HORS du score final.
FARCI_MODEL_CI=qwen3.5-2b
FARCI_MODEL_CI_QUANT=q4km
# Nom logique exposé à l'application (FARCI §17) : jamais le vrai modèle.
FARCI_MODEL_ALIAS=med-extraction
