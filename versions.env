#!/usr/bin/env bash
# FARCI — versions figées (FARCI §6)
#
# RÈGLE ABSOLUE : jamais `latest`, jamais `main`, jamais un tag flottant.
# Chaque tag ci-dessous a été vérifié comme EXISTANT par
# `scripts/lock-digests.sh` (phase 1), via `docker manifest inspect`.
#
# Les empreintes SHA256 des images sont dans versions.lock.env, généré en phase
# online. Tant que ce fichier est absent, `make verify-manifest` le signale et
# `make lint-versions` émet un avertissement (pas une erreur).
#
# Fichier versionné : c'est la SEULE source de vérité des versions. Aucun
# docker-compose.yml ne doit écrire une version en dur (contrôlé par le lint).

# --- Équipe 0 : GitOps ------------------------------------------------------
GITEA_VERSION=1.27.3
GITEA_ACT_RUNNER_VERSION=0.6.1
POSTGRES_VERSION=18.6-alpine

# --- Équipe 1 : réseau et dashboard ----------------------------------------
CADDY_VERSION=2.11.4-alpine
UPTIME_KUMA_VERSION=2.5.5

# --- Équipe 2 : inference ---------------------------------------------------
# llama.cpp n'a pas de tag semver : LLAMACPP_BUILD est un tag de version
# (b<N>) qui DOIT exister sur github.com/ggml-org/llama.cpp (la numérotation a
# des trous). Le préchargement le clone dans 02-inference/llamacpp/vendor/ et
# compile farci/llamacpp:server-b<N> pour la machine (voir docs/AIRGAP.md).
# Vérifier un tag : git ls-remote --tags https://github.com/ggml-org/llama.cpp b<N>
OLLAMA_VERSION=0.34.4
LLAMACPP_BUILD=b11500

# --- Équipe 3 : passerelle LLM ---------------------------------------------
LITELLM_VERSION=1.102.1
# Bifrost est l'implémentation OPTIONNELLE (FARCI §17 option 3B, brique bonus).
# Image maximhq/bifrost:v<version> sur Docker Hub (le tag porte un « v »).
BIFROST_VERSION=1.6.0

# --- Équipe 4 : documents ---------------------------------------------------
# Image ghcr.io/docling-project/docling-serve-cpu:v<version> (variante CPU,
# sans CUDA : plus légère, suffisante pour l'atelier). Même numérotation que
# le paquet PyPI docling-serve. L'ancien ds4sd/docling-serve:0.5.1 n'existe
# pas : vérifié dans le registre le 2026-10-23.
DOCLING_SERVE_VERSION=1.35.0

# --- Équipe 5 : observabilité ----------------------------------------------
PHOENIX_VERSION=20.16.0
LANGFUSE_VERSION=4.46.0
# Collecteur OTel : optionnel (fan-out Phoenix + Langfuse), brique bonus.
OTEL_COLLECTOR_VERSION=0.120.0

# --- Équipe 6 : évaluation --------------------------------------------------
# Image ghcr.io/mlflow/mlflow:v<version> (absente de Docker Hub).
MLFLOW_VERSION=3.16.1

# --- EDS-NLP (AP-HP), service de l'équipe 4 ---------------------------------
# Image construite au préchargement (farci/eds-nlp:<EDSNLP_VERSION>).
# eds-pseudo n'est pas publié sur PyPI : un commit du dépôt aphp/eds-pseudo.
EDSNLP_VERSION=0.23.0
EDS_PSEUDO_COMMIT=b8bfde4a0e6ca31ac5ea85483757294d48f19d03

# --- Étape 2 : applications clientes ---------------------------------------
OPEN_WEBUI_VERSION=0.11.4
FLOWISE_VERSION=3.1.4

# --- Images utilitaires -----------------------------------------------------
REDIS_VERSION=8.8.3-alpine
PYTHON_VERSION=3.13.15
PYTHON_IMAGE_TAG=3.13.15-slim-trixie
# Postes étudiants servis par le Pi (./bin/farci partage wheels) : versions
# de Python et plateformes pour lesquelles le Pi télécharge des wheels.
PARTAGE_PYTHONS=3.11,3.12,3.13
PARTAGE_PLATEFORMES=manylinux_2_28_x86_64,manylinux_2_17_x86_64,manylinux2014_x86_64,manylinux_2_28_aarch64,manylinux_2_17_aarch64,manylinux2014_aarch64,macosx_14_0_arm64,macosx_11_0_arm64,macosx_10_13_x86_64,macosx_10_9_x86_64
# Image des jobs de CI sur le runner Gitea (label « farci ») : contient git,
# bash, python3 et node (nécessaire aux actions). Préchargée comme le reste.
CI_RUNNER_NODE_VERSION=20.19.5-bookworm

# --- Modèles (FARCI §9, choix documenté dans PLAN.md §0.2) ------------------
# Ce sont des LOGIQUES, pas des images : le runtime est interchangeable.
FARCI_MODEL_PRIMARY=ornith-1.5-9b
FARCI_MODEL_PRIMARY_QUANT=q5km
FARCI_MODEL_LARGE=qwen3.8-27b
FARCI_MODEL_LARGE_QUANT=q4km
# Modèle de CI et de développement : volontairement HORS du score final.
FARCI_MODEL_CI=qwen3.5-2b
FARCI_MODEL_CI_QUANT=q4km
# Nom logique exposé à l'application (FARCI §17) : jamais le vrai modèle.
FARCI_MODEL_ALIAS=med-extraction
