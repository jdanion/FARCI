# FARCI — formatage et espaces
#
# Objectif : éviter les diffs sans fin -.gitattributes sert à cela pour les fins
# de ligne, .editorconfig pour l'indentation.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.sh]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
# En Markdown, deux espaces en fin de ligne = un retour à la ligne.
trim_trailing_whitespace = false
