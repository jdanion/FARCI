# FARCI — adresses du réseau de la salle (FARCI §4)
#
#   cp config/network.env.example config/network.env
#
# Ce fichier est la SEULE source de vérité des adresses IP. Il est versionné
# sous forme d'exemple, jamais commité lui-même. Les autres fichiers ne
# contiennent AUCUNE adresse : ils nomment les variables ci-dessous
# (`./bin/farci lint-ips` le vérifie).
#
# LE MODÈLE : « une IP de machine + un port par service »
# ------------------------------------------------------
# - Le Raspberry Pi du formateur crée le Wi-Fi de la salle et porte la PILE
#   DE RÉFÉRENCE (reference/) : c'est REFERENCE_IP.
# - L'ACCUEIL DE LA SALLE est le Caddy du Pi (REFERENCE_IP:ENTRY_PORT). Les
#   applications, LiteLLM et les traces passent par lui. Pour chaque brique,
#   il sert celle de l'équipe si elle est saine, sinon celle de la référence.
# - Une brique d'équipe est jointe par l'IP de la MACHINE qui l'héberge et le
#   port PUBLIÉ de ce service. Chaque service a son propre port : plusieurs
#   briques peuvent tourner sur la même machine sans conflit.
#
# Sur un poste étudiant, seule REFERENCE_IP compte. Les IP des briques
# d'équipe ne sont utiles que sur le Pi (et la machine de l'équipe 1) ; le
# formateur les renseigne avec `./bin/farci room set <brique> <ip>`.
# Une variable d'IP vide = brique pas encore montée : la référence la sert.

# --- Réseau de la salle (point d'accès Wi-Fi du Pi) -----------------------
FARCI_SUBNET=192.168.50.0/24
REFERENCE_IP=192.168.50.1

# --- Machines des équipes (renseignées le jour J sur le Pi) ---------------
# Équipe 1 : accueil de l'équipe (Caddy) et agrégateur de santé
CADDY_IP=
HEALTH_AGGREGATOR_IP=
UPTIME_KUMA_IP=
# Équipe 2 : runtimes d'inférence
INFERENCE_A_IP=
INFERENCE_B_IP=
INFERENCE_C_IP=
# Équipe 3 : passerelles
GATEWAY_A_IP=
GATEWAY_B_IP=
# Équipe 4 : documents
DOCLING_IP=
# Équipe 5 : observabilité
OBSERVABILITY_A_IP=
OBSERVABILITY_B_IP=
OTEL_COLLECTOR_IP=
# Équipes 6, 7, 0 : évaluation, applications, GitOps
MLFLOW_IP=
OPEN_WEBUI_IP=
FLOWISE_IP=
GITEA_IP=

# --- Ports publiés : UN port par service, identiques sur toutes les machines
ENTRY_PORT=80
CADDY_PORT=8080
HEALTH_AGGREGATOR_PORT=8088
UPTIME_KUMA_PORT=3001
INFERENCE_A_PORT=11434
INFERENCE_B_PORT=8081
INFERENCE_C_PORT=8082
REPLAY_PORT=8090
GATEWAY_A_PORT=4000
GATEWAY_B_PORT=4001
DOCLING_PORT=5001
PHOENIX_PORT=6006
LANGFUSE_PORT=3100
OTEL_COLLECTOR_PORT=4318
MLFLOW_PORT=5000
OPEN_WEBUI_PORT=3080
FLOWISE_PORT=3200
GITEA_PORT=3000
