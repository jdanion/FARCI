# FARCI — adresses du réseau pédagogique (FARCI §4)
#
#   cp config/network.env.example config/network.env
#
# Ce fichier est la SEULE source de vérité des adresses IP. Il est versionné
# sous forme d'exemple, jamais commité lui-même (les étudiants ont des
# adresses différentes).
#
# Les autres fichiers ne doivent contenir AUCUNE adresse en dur : ils
# référencent les variables ci-dessous. `make lint-ips` le vérifie, et
# `config/services.yaml` référence également ces noms de variables.

# Sous-réseau du réseau pédagogique
FARCI_SUBNET=192.168.50.0/24
FARCI_GATEWAY=192.168.50.1

# --- Adresses conventionnelles -------------------------------------------
GITEA_IP=192.168.50.10
CADDY_IP=192.168.50.15
INFERENCE_A_IP=192.168.50.20
INFERENCE_B_IP=192.168.50.21
INFERENCE_C_IP=192.168.50.22
GATEWAY_A_IP=192.168.50.30
GATEWAY_B_IP=192.168.50.31
OBSERVABILITY_A_IP=192.168.50.40
OBSERVABILITY_B_IP=192.168.50.41
DOCLING_IP=192.168.50.46
MLFLOW_IP=192.168.50.47
UPTIME_KUMA_IP=192.168.50.50
# Ajout FARCI (non présent dans FARCI.md §4) : l'agrégateur de santé doit
# être joignable pour que le moniteur synthétique "CLINICAL AI PIPELINE"
# puisse exister (FARCI §14).
HEALTH_AGGREGATOR_IP=192.168.50.51
# Applications clientes : adresse propre à chacune. Elles restent DERRIÈRE Caddy
# pour les utilisateurs, mais les sondes de santé les atteignent directement —
# deux services ne doivent jamais partager le couple (adresse, port).
OPEN_WEBUI_IP=192.168.50.52
FLOWISE_IP=192.168.50.53

# --- Ports internes (réseau farci uniquement, non publiés sur l'hôte) ----
GITEA_PORT=3000
CADDY_INTERNAL_PORT=8080
INFERENCE_PORT=8080
GATEWAY_PORT=4000
DOCLING_PORT=5001
PHOENIX_PORT=6006
LANGFUSE_PORT=3000
MLFLOW_PORT=5000
UPTIME_KUMA_PORT=3001
HEALTH_AGGREGATOR_PORT=8088
FLOWISE_PORT=3000
OPEN_WEBUI_PORT=8080

# --- Ports publiés sur la machine hôte (uniquement ce qui doit l'être) ----
# Règle pédagogique : un service n'est publié que s'il doit être ouvert
# depuis un navigateur. Tout le reste passe par Caddy.
GITEA_PUBLISHED_PORT=3000
UPTIME_KUMA_PUBLISHED_PORT=3001
