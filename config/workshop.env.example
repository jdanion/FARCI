# FARCI — réglages de l'atelier (surchargent .env, surchargés par l'environnement)
#
#   cp config/workshop.env.example config/workshop.env
#
# Ce qui est propre à UN poste et non à toute la classe.
# Exemple : l'équipe de l'étudiant, ou le parcours d'application choisi.

# Équipe de ce poste (0 à 8, voir ./bin/farci read <équipe>) : ./preload.sh ne
# télécharge que sa brique, selon la machine (scripts/lib/machine.sh).
FARCI_EQUIPE=

# Profil matériel : vide = détecté. Grosse configuration = GPU NVIDIA ou
# FARCI_GROSSE_RAM_GO de RAM ; elle seule sert Ollama + modèle 9B et Langfuse.
FARCI_MACHINE=
FARCI_GROSSE_RAM_GO=32

# Rôle de ce poste dans l'atelier (valeurs de FARCI §45)
#   full        toutes les briques (poste animateur)
#   client      application seulement (poste étudiant standard)
#   inference   runtime seulement
#   gateway     gateway seulement
#   observability
FARCI_ROLE=client

# Fichier servi par llama.cpp (vide = choisi selon ce qui est préchargé et la
# RAM). Pour comparer deux modèles : Qwen3.5-4B-Q4_K_M.gguf, puis
# gemma-4-E4B-it-Q4_K_M.gguf ou medgemma-4b-it-UD-Q4_K_XL.gguf (./bin/farci verify-models liste les fichiers).
LLAMACPP_GGUF=

# Parcours d'application de l'étudiant (FARCI §29-33) : python | webui
FARCI_TRACK=python

# Composition du pipeline de référence, pilotée par variables (§58).
# Ces valeurs sont résolues par Caddy et la gateway, jamais par l'application.
FARCI_INFERENCE_PRIMARY=ollama
FARCI_INFERENCE_FALLBACK=llamacpp
FARCI_GATEWAY=litellm
FARCI_OBSERVABILITY=phoenix

# Jeu de données : quick (10 cas) | standard (20 cas)  — FARCI §25
FARCI_PROFILE=standard

# Affichage des traces : off | on   (les traces detaillees coutent du temps)
FARCI_TRACE=on

# Durée maximale d'un scénario de chaos avant revert automatique (secondes)
FARCI_CHAOS_MAX_DURATION=120
