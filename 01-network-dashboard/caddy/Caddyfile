# FARCI — Caddy reverse proxy (FARCI §12)
#
# Routage des services internes. HTTP only (air-gap prime sur TLS, §61.1).
# handle_errors renvoie un JSON explicite pour débogage.
#
# Aucune adresse ici : Caddy lit ses variables d'environnement avec la
# syntaxe {$NOM} (et non ${NOM}). Elles sont transmises par
# docker-compose.yml depuis config/network.env.

:{$CADDY_INTERNAL_PORT} {
    # Santé globale du pipeline et état détaillé (health-aggregator)
    handle /healthz {
        reverse_proxy {$HEALTH_AGGREGATOR_IP}:{$HEALTH_AGGREGATOR_PORT}
    }
    handle /status {
        reverse_proxy {$HEALTH_AGGREGATOR_IP}:{$HEALTH_AGGREGATOR_PORT}
    }

    # LLM Gateway (OpenAI-compatible) : le seul point d'entrée des applications
    handle /v1/* {
        reverse_proxy {$GATEWAY_A_IP}:{$GATEWAY_PORT}
    }

    # Docling (documents)
    handle_path /docling/* {
        reverse_proxy {$DOCLING_IP}:{$DOCLING_PORT}
    }

    # Observabilité (Phoenix)
    handle_path /observability/* {
        reverse_proxy {$OBSERVABILITY_A_IP}:{$PHOENIX_PORT}
    }

    # MLflow (évaluation, bonus)
    handle_path /mlflow/* {
        reverse_proxy {$MLFLOW_IP}:{$MLFLOW_PORT}
    }

    # Uptime Kuma (tableau de bord, bonus)
    handle_path /kuma/* {
        reverse_proxy {$UPTIME_KUMA_IP}:{$UPTIME_KUMA_PORT}
    }

    # Applications clientes
    handle_path /flowise/* {
        reverse_proxy {$FLOWISE_IP}:{$FLOWISE_PORT}
    }
    handle_path /webui/* {
        reverse_proxy {$OPEN_WEBUI_IP}:{$OPEN_WEBUI_PORT}
    }

    # Gitea (bonus)
    handle_path /gitea/* {
        reverse_proxy {$GITEA_IP}:{$GITEA_PORT}
    }

    # Erreurs JSON explicites
    handle_errors {
        header Content-Type application/json
        respond `{"error": "{http.error.status_code}", "message": "{http.error.status_text}"}` {http.error.status_code}
    }
}
