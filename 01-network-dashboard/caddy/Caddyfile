# FARCI — l'accueil (reverse proxy Caddy, FARCI §12)
#
# Ce même fichier sert DEUX accueils identiques :
#   - celui de la salle, sur le Pi du formateur (reference/docker-compose.yml) ;
#   - celui que monte l'équipe 1 (01-network-dashboard/docker-compose.yml).
#
# Aucune adresse ici. Caddy lit ses variables d'environnement avec {$NOM},
# AVANT de lire le fichier : une variable peut donc contenir plusieurs amonts.
# Les variables UP_* sont construites par `scripts/services.py upstreams` à
# partir de config/network.env (et de config/rescue.env) : « brique de
# l'équipe, puis brique de la référence ». Caddy essaie la première ; si
# elle ne répond pas, il passe à la suivante et l'écarte 20 secondes.
#
# HTTP seulement : l'air-gap prime sur TLS (§61.1).

(repli) {
    lb_policy first
    lb_try_duration 4s
    lb_try_interval 250ms
    fail_duration 20s
    max_fails 1
    unhealthy_status 5xx
    transport http {
        dial_timeout 2s
    }
}

:80 {
    # Vivacité de Caddy LUI-MÊME : ne dépend d'aucun autre service.
    handle /livez {
        respond "ok" 200
    }

    # État du pipeline (agrégateur de santé, dans la même compose)
    handle /healthz {
        reverse_proxy health-aggregator:8081
    }
    handle /status {
        reverse_proxy health-aggregator:8081
    }

    # Passerelle LLM (API OpenAI) : le seul point d'entrée des applications
    handle /v1/* {
        reverse_proxy {$UP_PASSERELLE} {
            import repli
        }
    }

    # Runtimes : utilisé par LiteLLM, jamais par les applications
    handle_path /runtime/* {
        reverse_proxy {$UP_INFERENCE} {
            import repli
            health_uri /v1/models
            health_interval 10s
        }
    }

    # Documents (Docling)
    handle_path /docling/* {
        reverse_proxy {$UP_DOCUMENTS} {
            import repli
        }
    }

    # Traces OTLP vers Phoenix : si l'observabilité tombe, la référence
    # reçoit, et l'extraction ne s'en aperçoit pas (scénario 07).
    handle_path /observability/* {
        reverse_proxy {$UP_OBSERVABILITE} {
            import repli
        }
    }

    # Erreurs JSON explicites
    handle_errors {
        header Content-Type application/json
        respond `{"error": "{http.error.status_code}", "message": "{http.error.status_text}"}` {http.error.status_code}
    }
}
