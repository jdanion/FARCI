# FARCI — configuration principale
#
#   cp .env.example .env
#
# Ce fichier n'est JAMAIS commité (voir .gitignore). Il contient les secrets
# et les réglages propres à une machine.
#
# Tout le reste est versionné : voir config/network.env.example (adresses) et
# config/services.yaml (registre des services).

# ---------------------------------------------------------------------------
# Emplacement des données lourdes — HORS du dépôt Git
# ---------------------------------------------------------------------------
# Le dépôt Git reste léger (< 8 Mo). Les images Docker, les poids de modèles et
# les wheels Python vivent ici, et `offline/` est un lien symbolique vers
# $FARCI_DATA_DIR/offline (cf. bootstrap.sh).
#
#   /srv/farci        disque serveur (partagé par l'animateur)
#   /media/usb/farci  clé USB (mode sans réseau)
#   ~/.farci          défaut si /srv n'est pas inscriptible
FARCI_DATA_DIR=/srv/farci

# ---------------------------------------------------------------------------
# D'où vient le projet (docs/GIT.md)
# ---------------------------------------------------------------------------
# Le code : GitHub est la source de vérité, joignable depuis la faculté. La
# forge Gitea de la salle (GITEA_IP, config/network.env) en est la copie locale.
FARCI_GITHUB_URL=https://github.com/jdanion/FARCI
# Les fichiers volumineux (poids de modèles, images Docker, wheels) : jamais
# dans Git, servis par le serveur du formateur. Arborescence attendue :
#   models/  wheels/  offline-x86/images/  offline-arm64/images/
# (ce que publie ./bin/farci partage publier). Vide : registres et sites d'origine.
FARCI_FICHIERS_URL=https://hildansic.fr/farci

# ---------------------------------------------------------------------------
# Identité de l'atelier
# ---------------------------------------------------------------------------
FARCI_WORKSHOP_NAME=FARCI
# Ton identifiant d'étudiant : utilisé pour datasets/extracted/<id>/
FARCI_STUDENT_ID=
FARCI_LOCALE=fr-FR
FARCI_TIMEZONE=Europe/Paris

# ---------------------------------------------------------------------------
# Datasources / datasets
# ---------------------------------------------------------------------------
# Semence du générateur de données synthétiques : ne JAMAIS la changer en
# cours d'atelier, sinon le gold standard ne correspond plus.
FARCI_DATASET_SEED=20260926
# Cas traités (10 = jeu rapide, 20 = jeu standard)
FARCI_CASES=20

# ---------------------------------------------------------------------------
# Clés virtuelles de la gateway
# ---------------------------------------------------------------------------
# Valeurs de départ UNIQUEMENT. Les régénérer avec :  make keys-reset
GATEWAY_KEY_STANDARD=sk-farci-standard-a-remplacer
GATEWAY_KEY_PRIORITY=sk-farci-priority-a-remplacer
LITELLM_MASTER_KEY=sk-farci-master-a-remplacer
BIFROST_CONFIG_KEY=sk-farci-bifrost-a-remplacer

# ---------------------------------------------------------------------------
# Forge de la salle (Gitea, équipe 0) — secrets, à générer avant l'atelier
# ---------------------------------------------------------------------------
GITEA_ADMIN_PASSWORD=farci-admin-a-remplacer
GITEA_DB_PASSWORD=farci-gitea-db-a-remplacer
GITEA_SECRET_KEY=farci-gitea-secret-a-remplacer
GITEA_INTERNAL_TOKEN=farci-gitea-token-a-remplacer
GITEA_RUNNER_TOKEN=farci-runner-token-a-remplacer
# Mot de passe commun des comptes equipe-0 à equipe-8 (écrit au tableau)
GITEA_EQUIPE_PASSWORD=farci-salle-a-remplacer

# ---------------------------------------------------------------------------
# Base de données (partagée : Gitea, Langfuse, MLflow)
# ---------------------------------------------------------------------------
POSTGRES_USER=farci
POSTGRES_PASSWORD=farci-a-remplacer
POSTGRES_DB=farci

# ---------------------------------------------------------------------------
# Observabilité
# ---------------------------------------------------------------------------
# Phoenix = implémentation par défaut, Langfuse = alternative (contrat OTel commun)
OBSERVABILITY_BACKEND=phoenix
OTEL_SERVICE_NAMESPACE=farci
# Jamais de cloud : on refuse explicitement tout endpoint distant (§52).
# OTEL_EXPORTER_OTLP_ENDPOINT est DÉRIVÉ de config/network.env par
# scripts/dev-env.sh (Phoenix) : ne l'écrire ici que pour le surcharger.


# ---------------------------------------------------------------------------
# Points d'entrée (Caddy) — §12, §16
# ---------------------------------------------------------------------------
# FARCI_GATEWAY_URL, FARCI_DOCLING_URL et FARCI_STATUS_URL sont DÉRIVÉS de
# CADDY_IP (config/network.env) par scripts/dev-env.sh. Aucune adresse ici :
# config/network.env est le seul fichier qui en contient.

# ---------------------------------------------------------------------------
# Comportement
# ---------------------------------------------------------------------------
# Interdit tout accès réseau sortant lors des tests (défaut: actif si possible)
FARCI_ENFORCE_OFFLINE=1
# Timeout réseau par défaut (secondes) pour les sondes de santé
FARCI_HEALTH_TIMEOUT=3
