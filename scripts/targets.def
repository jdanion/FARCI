# FARCI — registre des cibles (source de vérité unique)
# =============================================================================
# Colonnes séparées par des TAB : nom, groupe, description, script.
# Ce fichier est lu par DEUX consommateurs :
#   - bin/farci          (le lanceur)  : ./bin/farci <nom>
#   - Makefile                          : make <nom>
# Il est donc impossible que les deux proposent des listes différentes : c'est
# l'un des moyens de garantir qu'un dépôt air-gappé reste utilisable même
# sans `make` installé (beaucoup de postes étudiants n'ont pas make).
#
# Règles :
#   - une ligne par cible, aucune ligne sans script
#   - le script doit exister et être exécutable, sinon `farci help` le signale
#   - les noms sont kebab-case, sans espace
#   - le groupe doit figurer dans GROUP_ORDER (scripts/cmd/help.sh)
# =============================================================================

help	atelier	Afficher cette aide	help.sh
doctor	atelier	Diagnostic de la machine (docker, python, RAM, disque)	doctor.sh
bootstrap	atelier	Préparer la machine (hors ligne, .env, outils)	bootstrap.sh
status	atelier	Tableau de progression du workshop (§49)	status.sh
tableau	atelier	Tableau de la salle (page web, iPad) : adresses, reset	tableau.sh
up	atelier	Démarrer une brique : up <dossier> (ex. 02-inference/ollama)	compose.sh
down	atelier	Arrêter une brique : down <dossier>	compose.sh
logs	atelier	Journaux d'une brique : logs <dossier>	compose.sh
read	atelier	Lire le TUTORIAL d'une équipe	read.sh
docs	atelier	Ouvrir la documentation (ARCHITECTURE, CONTRACTS...)	docs.sh
checklist	atelier	Checklist formateur (INSTRUCTOR_GUIDE)	docs.sh
casting	atelier	Répartition des équipes selon le matériel	casting.sh
version	atelier	Versions figées du dépôt (versions.env)	version.sh
env	atelier	Afficher la configuration effective	env.sh
env-check	atelier	Valider la configuration (adresses, sous-réseau)	env.sh
services	atelier	Lister le registre des services	services.sh
network-check	atelier	Vérifier cohérence registre <-> adresses	network-check.sh
room	atelier	Qui héberge quoi ; room set <équipe> <ip> (sur le Pi)	room.sh
core-up	atelier	Machine seule : pile de référence + Docling (FARCI.md)	pile.sh
dashboard-up	atelier	Machine seule : accueil + agrégateur, adresses utiles	pile.sh
health	atelier	Tableau, code 0 si le service rendu est READY	pile.sh

preload	airgap	Précharger les artefacts air-gap (avec Internet)	preload.sh
verify-airgap	airgap	Vérifier que le workshop fonctionne hors ligne	verify-airgap.sh
gen-manifest	airgap	Écrire offline/MANIFEST.sha256	gen-manifest.sh
verify-manifest	airgap	Vérifier les empreintes contre le manifeste	verify-manifest.sh
verify-images	airgap	Vérifier les images Docker locales	verify-images.sh
verify-models	airgap	Vérifier les poids de modèles	verify-models.sh
verify-wheels	airgap	Vérifier les wheels Python	verify-wheels.sh
forge-sync	airgap	GitHub → Gitea : main en avance rapide seulement (status, push, bundle)	forge-sync.sh

generate-dataset	dataset	Générer le dataset synthétique (.txt, --pdf pour Docling)	generate-dataset.sh
build-gold	dataset	Générer le gold standard depuis le registre	build-gold.sh
make-quick-set	dataset	Afficher le sous-ensemble quick (10 cas)	make-quick-set.sh
extract	dataset	Étape 2, parcours Python : extraire tous les dossiers	extract.sh
eds	dataset	Étape 2, EDS-NLP (AP-HP) : pseudo | entites | compare	eds.sh
evaluate	dataset	Comparer les extractions au gold, classer les runs	evaluate.sh

chaos	chaos	Étape 3 : list | scenario-NN | status | reset	chaos.sh

rescue	secours	Basculer une brique sur la référence (sur le Pi)	rescue.sh
reset-all	secours	Retour à un état propre connu (sur le Pi)	reset-all.sh
rehearse	secours	Répétition générale J-1 (< 15 min) : PASS / FAIL	rehearse.sh
replay	secours	Runtime rejoué sans Docker ni modèle (plan C)	replay.sh

ci	qualité	Ce que la CI exécute (selftest, lint, tests, gold)	ci.sh
selftest	qualité	Auto-tests de l'outillage (registre, parseurs, --help)	selftest.sh
test-unit	qualité	Tests unitaires Python (sans réseau ni GPU)	test-unit.sh
test	qualité	Tests d'intégration des briques déployées	test.sh
lint	qualité	Toute la batterie de contrôles	lint.sh
lint-versions	qualité	Aucun tag flottant, versions épinglées	lint.sh
lint-ips	qualité	Aucune adresse IP en dur hors configuration	lint.sh
lint-docs	qualité	Documentation et TUTORIALs conformes (§45)	lint.sh
lint-offline	qualité	Politique air-gap (pas de CDN, pas de pull)	lint.sh
lint-todo	qualité	Ni TODO ni stub dans le code livré	lint.sh
lint-shell	qualité	Syntaxe bash (+ shellcheck si disponible)	lint.sh
lint-python	qualité	Syntaxe Python (compilation)	lint.sh
lint-commands	qualité	Les docs ne citent que des commandes qui existent	lint.sh

clean	nettoyage	Supprimer les artefacts locaux (demande --yes)	clean.sh
